; Dual extrusion with a loaded bed mesh: T1 must look up the mesh under its
; own nozzle (BED_MESH_OFFSET)
PRINT_START BED=60 EXTRUDER=210 EXTRUDER1=215 TOOL=1 MESH=load PROFILE=default Z_OFFSET_SCAN=0
G90
M83
G1 Z0.25 F600
G1 X30 Y40 F6000
G1 X140 Y40 E5 F1500
T0
G1 X140 Y60 F6000
G1 X30 Y60 E5 F1500
M3000
M3001
T1
G1 X100 Y200 E3 F1500
BED_MESH_OUTPUT
PRINT_END
