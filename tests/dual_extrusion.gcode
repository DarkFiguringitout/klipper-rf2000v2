; Simulated dual extrusion print as a slicer would send it
PRINT_START BED=60 EXTRUDER=210 EXTRUDER1=215 TOOL=0 MESH=none Z_OFFSET_SCAN=0 MONITOR=0
G90
M83
G1 Z0.3 F600
; T0 layer
G1 X20 Y20 F6000
G1 X120 Y20 E4 F1800
G1 X120 Y120 E4
M104 T1 S215
T1
; T1 must reach the same XY with its own nozzle
G1 X20 Y120 F6000
G1 X20 Y20 E4 F1800
G1 X150 Y20 E5
G1 X0 Y0 F6000
T0
G1 X0 Y0 F6000
G1 X170 Y0 E6 F1800
; pause and resume while T1 is active
T1
G1 X50 Y50 F6000
PAUSE
RESUME
G1 X60 Y60 E1 F1800
T0
M106 S128
M107
SET_TOOL_OFFSET X=33.5 Y=0.1 Z=-0.02
T1
G1 X10 Y10 F6000
T0
PRINT_END
