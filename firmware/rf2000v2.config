# Klipper MCU firmware configuration for the Renkforce RF2000v2 mainboard
# (ATmega2560, 16MHz, USB-serial on UART0, Arduino/stk500v2 bootloader)
# Use with: make KCONFIG_CONFIG=<this file> olddefconfig && make
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_AVR=y
CONFIG_MACH_atmega2560=y
CONFIG_AVR_FREQ_16000000=y
CONFIG_AVR_SERIAL_UART0=y
CONFIG_SERIAL_BAUD=250000
